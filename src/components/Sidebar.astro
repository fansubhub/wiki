---
import Default from "@astrojs/starlight/components/Sidebar.astro";
import TopicsDropdown from "starlight-sidebar-topics-dropdown/TopicsDropdown.astro";
import ImageZoom from "./ImageZoom.astro";
import { execSync } from "node:child_process";
import fs from "node:fs";

const { sidebar } = Astro.props;

const DIAS_NUEVO = 14; // Días para considerar una guía como "Nueva"
const DIAS_ACTUALIZADO = 7; // Días para considerar una guía como "Actualizada"
const AHORA = Date.now();
const MS_POR_DIA = 1000 * 60 * 60 * 24;

function obtenerRutaFisica(slug: string) {
    // Manejo de rutas raíz o vacías
    const base = slug ? `src/content/docs/${slug}` : "src/content/docs/index";
    const posibles = [
        `${base}.mdx`,
        `${base}.md`,
        `${base}/index.mdx`,
        `${base}/index.md`,
    ];
    return posibles.find((ruta) => fs.existsSync(ruta)) || null;
}

function obtenerFechasGit(slug: string) {
    try {
        const rutaArchivo = obtenerRutaFisica(slug);
        if (!rutaArchivo) return { creado: null, actualizado: null };

        // Timestamp del primer commit (creación)
        const primerCommit = execSync(
            `git log --diff-filter=A --follow --format=%at -1 -- "${rutaArchivo}" 2>/dev/null`,
        )
            .toString()
            .trim();

        // Timestamp del último commit (modificación)
        const ultimoCommit = execSync(
            `git log -1 --format=%at -- "${rutaArchivo}" 2>/dev/null`,
        )
            .toString()
            .trim();

        return {
            creado: primerCommit ? parseInt(primerCommit, 10) * 1000 : null,
            actualizado: ultimoCommit
                ? parseInt(ultimoCommit, 10) * 1000
                : null,
        };
    } catch {
        return { creado: null, actualizado: null };
    }
}

function procesarSidebar(items: any[]) {
    if (!items) return;

    for (const item of items) {
        if (item.type === "link") {
            // Si ya tiene un badge asignado manualmente en el frontmatter, se respeta
            if (!item.badge && item.href) {
                const slug = item.href.replace(/^\/|\/$/g, "");
                const { creado, actualizado } = obtenerFechasGit(slug);

                if (creado) {
                    const diasDesdeCreacion = (AHORA - creado) / MS_POR_DIA;
                    const diasDesdeActualizacion = actualizado
                        ? (AHORA - actualizado) / MS_POR_DIA
                        : Infinity;

                    if (diasDesdeCreacion <= DIAS_NUEVO) {
                        item.badge = { text: "Nuevo", variant: "success" };
                    } else if (
                        diasDesdeActualizacion <= DIAS_ACTUALIZADO &&
                        diasDesdeCreacion > DIAS_ACTUALIZADO
                    ) {
                        item.badge = { text: "Actualizado", variant: "note" };
                    }
                }
            }
        } else if (item.type === "group" && item.entries) {
            procesarSidebar(item.entries);
        }
    }
}

// Inyecta los badges calculados en el árbol de navegación
if (sidebar) {
    procesarSidebar(sidebar);
}
---

{/* Render the topics dropdown menu. */}
<TopicsDropdown />

{/* Render the default sidebar con las propiedades mutadas. */}
<Default {...Astro.props} sidebar={sidebar}>
    <slot />
</Default>

<ImageZoom />
